{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Java",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "${workspaceFolder}/out",
        "${workspaceFolder}/src/Main.java",
        "${workspaceFolder}/src/Supply.java",
        "${workspaceFolder}/src/Workshop.java"
      ],
      "problemMatcher": ["$javac"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Main",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "${workspaceFolder}/out",
        "Main"
      ],
      "dependsOrder": "sequence",
      "dependsOn": "Compile Java",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}

